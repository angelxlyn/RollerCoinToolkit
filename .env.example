# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: The connection string for MongoDB Atlas.
# Users configure this via the Secrets panel in the AI Studio UI.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/miner_db?retryWrites=true&w=majority"

# GOOGLE_SERVICE_ACCOUNT_JSON: The JSON key for your Google Service Account.
# Required for Google Sheets sync.
GOOGLE_SERVICE_ACCOUNT_JSON=

# SUPABASE_URL: The URL for your Supabase project.
# Users configure this via the Secrets panel in the AI Studio UI.
VITE_SUPABASE_URL=

# SUPABASE_ANON_KEY: The anonymous key for your Supabase project.
# Users configure this via the Secrets panel in the AI Studio UI.
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: The service role key for your Supabase project.
# Required for backend operations to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
